# OpenRouter — all models route through here
OPENAI_API_KEY=sk-or-v1-your-openrouter-key
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Default eval model (override with --model on CLI)
INSPECT_EVAL_MODEL=openai/anthropic/claude-sonnet-4-6

# Grader model for LLM-as-judge scoring
INSPECT_GRADER_MODEL=openai/anthropic/claude-sonnet-4-6

# Logging
INSPECT_LOG_DIR=./logs
INSPECT_LOG_LEVEL=info

# Modal (only needed if using modal sandbox)
# MODAL_TOKEN_ID=...
# MODAL_TOKEN_SECRET=...
