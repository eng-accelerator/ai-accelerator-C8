# Copy this file to .env in this same folder (Day_10/) and fill in real values:
#   cp .env.example .env
#
# load_dotenv() looks in the current working directory, so run every script
# from inside Day_10/ (cd Day_10 first) for .env to actually be picked up.
#
# All five scripts now run on OpenRouter alone -- no native OpenAI key needed.

# --- OpenRouter --------------------------------------------------------
# Used by all five scripts:
#   simple_without_lcel-1.py, simple_lcel (1).py, agent-simple-updated.py
#     -- required, no fallback
#   csv_1.py, updated-arag.py
#     -- optional here, both also accept it pasted into the Streamlit sidebar
OPENROUTER_API_KEY=

# --- Tavily ------------------------------------------------------------
# Used by: updated-arag.py -- NOTE this file only reads it from the Streamlit
# sidebar text box, not from .env. Listed here just so the key is in one
# place; you'll still paste it into the running app.
TAVILY_API_KEY=

# --- LangSmith (optional) ---------------------------------------------------
# Used by: csv_1.py -- the line `langsmith_key = ""` near the top is where
# you paste a real key to switch tracing on for the LangSmith demo block.
LANGSMITH_API_KEY=
